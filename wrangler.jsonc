{
  "$schema": "node_modules/wrangler/config-schema.json",
  // See workers/MatchDurableObject.ts and docs/architecture/deployment.md for
  // what this deployment does and does not do yet (`[ITEM-045]`). This is an
  // *additional*, optional hosting path for a match server: the static
  // client still deploys to GitHub Pages (`.github/workflows/deploy.yml`) by
  // default, untouched by this file.
  "name": "tictac-match-server",
  "main": "workers/index.ts",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Every request reaches the Worker (and so the one Durable Object)
    // rather than being served by the assets layer directly: the deployment
    // asked for a single DO that serves both websocket and static assets.
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  // The real deploy's domain (`[ITEM-045]`) — a `*.workers.dev` subdomain is
  // on the public suffix list, so the relying party id has to be this exact
  // host, not just `workers.dev`; see `workers/MatchDurableObject.ts`'s
  // `relyingPartyOf` and `LOCAL_RELYING_PARTY` in `src/server/Persistence.ts`
  // for what this falls back to when unset.
  "vars": {
    "RELYING_PARTY_ID": "tictac-match-server.waldemar-reusch.workers.dev",
    // The GitHub Pages client signs in with this host's passkeys through
    // WebAuthn related origins: `/.well-known/webauthn` lists these
    // (`src/server/RelatedOrigins.ts`). An origin has no path.
    "RELYING_PARTY_ORIGINS": "https://tictac-match-server.waldemar-reusch.workers.dev,https://lordvlad.github.io",
    // The map archive in `MAP_TILES`, named for what it holds; a new build is
    // uploaded under a new key (`scripts/build-planet-tiles.ts`) and swapped in
    // here (`[ITEM-061]`, docs/architecture/deployment.md §6).
    "MAP_TILES_KEY": "planet-z8-20261007.pmtiles",
    // The same dated build as the archive above, read by range for the zooms
    // it stops short of; each tile is built once and kept in `MAP_TILES` under
    // `demand/20261007/` (`[ITEM-067]`, deployment.md §6.4). Change both
    // together: a different build's tiles would not match the archive's.
    "MAP_SOURCE_URL": "https://build.protomaps.com/20261007.pmtiles"
  },
  // How many tiles one client may make the server build per minute: a pan
  // over ground already built is free. `namespace_id` is any number you pick.
  "ratelimits": [
    { "name": "TILE_BUILDS", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } }
  ],
  // Map tiles, answered by `workers/index.ts` before the Durable Object.
  // `wrangler dev` simulates the bucket locally and empty unless seeded.
  "r2_buckets": [
    { "binding": "MAP_TILES", "bucket_name": "map-tiles" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "MATCH", "class_name": "MatchDurableObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MatchDurableObject"] }
  ]
}
