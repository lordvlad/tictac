{
  "name": "tictac",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "preview": "NODE_ENV=production bun src/index.ts",
    "lint": "bun run --parallel typecheck lint:docs",
    "lint:docs": "bun scripts/lint-docs.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "balance": "bun scripts/balance.ts",
    "build": "bun run typecheck && bun run build:bundle && bun run build:public",
    "build:bundle": "bun build ./src/index.html --outdir=dist --sourcemap --target=browser --minify --public-path=./ --define:process.env.NODE_ENV='\"production\"'",
    "build:public": "bun scripts/copy-public.mjs",
    "build:character": "bun scripts/build-character.mjs",
    "build:icons": "bun scripts/build-icons.mjs",
    "icons": "bun run build:icons"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.18.2",
    "@mavonengine/core": "^0.0.20",
    "@tweakpane/plugin-essentials": "^0.2.1",
    "@use-gesture/vanilla": "^10.3.1",
    "peerjs": "^1.5.5",
    "three": "0.184.0",
    "three-perf": "^1.0.11",
    "tweakpane": "^4.0.5"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@types/bun": "latest",
    "@types/three": "~0.184.0",
    "typescript": "^5.9.0"
  }
}
