{
  "name": "tictac",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "preview": "NODE_ENV=production bun src/index.ts",
    "lint": "bun run --parallel typecheck typecheck:cf lint:docs lint:code schema:catalog:check",
    "lint:code": "biome lint --only=suspicious/noDuplicateCase src scripts tests workers",
    "lint:docs": "bun scripts/lint-docs.ts",
    "docs:catalog": "bun scripts/build-catalog.ts",
    "schema:catalog": "bun scripts/build-schema-catalog.ts",
    "schema:catalog:check": "bun scripts/build-schema-catalog.ts --check",
    "typecheck": "tsc --noEmit",
    "typecheck:cf": "tsc --noEmit -p workers/tsconfig.json",
    "test": "bun test",
    "balance": "bun scripts/balance.ts",
    "build": "bun run typecheck && bun run build:bundle && bun run build:public",
    "build:bundle": "bun scripts/build-bundle.ts",
    "build:public": "bun scripts/copy-public.mjs",
    "build:character": "bun scripts/build-character.mjs",
    "build:icons": "bun scripts/build-icons.mjs",
    "icons": "bun run build:icons",
    "replay": "bun scripts/replay.ts",
    "serve:match": "bun scripts/serve-match.ts",
    "cf:dev": "bun run build && wrangler dev",
    "cf:deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.18.2",
    "@mavonengine/core": "^0.0.20",
    "@tweakpane/plugin-essentials": "^0.2.1",
    "@use-gesture/vanilla": "^10.3.1",
    "peerjs": "^1.5.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "0.184.0",
    "three-perf": "^1.0.11",
    "tweakpane": "^4.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@cloudflare/workers-types": "^5.20260930.2",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@happy-dom/global-registrator": "^20.14.5",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "~0.184.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.145.0"
  }
}
