{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/project/docs/schemas/backlog-item-schema.json",
  "title": "BacklogItem",
  "description": "Schema for structured backlog items, user stories, and technical tasks in Kanban workflow.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(ENG|GAME|ARCH|PERF|ASSET|UI)-[0-9]{3,4}$",
      "description": "Standardized item key (e.g. ENG-010, GAME-002, ARCH-001, UI-001)."
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 100,
      "description": "Short imperative summary."
    },
    "type": {
      "type": "string",
      "enum": ["feature", "tech-debt", "bug", "refactor", "balance", "infrastructure"],
      "description": "Work category."
    },
    "status": {
      "type": "string",
      "enum": ["backlog", "ready", "in-progress", "blocked", "completed", "dropped"],
      "description": "Execution status in Kanban flow."
    },
    "priority": {
      "type": "string",
      "enum": ["p0", "p1", "p2", "p3"],
      "description": "P0=Critical/Next, P1=High, P2=Medium, P3=Low/Nice-to-have."
    },
    "milestone": {
      "type": "string",
      "description": "Target capability milestone (e.g. M1 — Headless Foundation, M2 — Tactical Depth)."
    },
    "why": {
      "type": "string",
      "description": "Rationale and problem statement."
    },
    "change": {
      "type": "string",
      "description": "Exact description of the change and technical approach."
    },
    "affectedFiles": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Expected source files/directories touched."
    },
    "acceptance": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "Verifiable criteria required for completion."
    },
    "risks": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Known risks, failure modes, or breaking changes."
    }
  },
  "required": ["id", "title", "type", "status", "priority", "why", "change", "acceptance"]
}
